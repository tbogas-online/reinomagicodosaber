# Copia para .env.local e preenche (nunca commits .env.local).
# Credenciais iguais às do painel /admin-reports.html.

REPORTS_ADMIN_USER=admin
REPORTS_ADMIN_PASS=a_tua_palavra_passe

# IA — obrigatório em local (modo offline não herda as chaves do Netlify em produção)
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Desenvolvimento local (npm run dev) — zero créditos Netlify em produção.
# GENERATE_ALLOW_PUBLIC=true   # activado automaticamente pelo npm run dev
# DEV_PORT=8888                # porta local (opcional)
# DEV_LIVE=1                   # usar env do site Netlify ligado (opcional; por defeito --offline)

# Ferramentas de QA em /admin/ (requerem credenciais admin; /api/generate aceita Basic Auth).
# GENERATE_ALLOW_PUBLIC=true só para desenvolvimento local sem login.

# URL do site em produção (Cloudflare Pages ou Netlify legado)
REPORTS_BASE_URL=https://reinomagicodosaber.pages.dev

# Multijogador + telemetria IA — painel admin (Netlify Functions)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  (Project Settings → API → service_role — NUNCA no browser)
# Executar também supabase/gen-telemetry.sql no SQL Editor do Supabase.
#
# Importação diária do Knowledge Repository (Supabase — ver supabase/knowledge-import-queue.sql):
#   npm run import:knowledge:sync   # copiar fila JSON → Supabase (primeira vez)
#   npm run import:knowledge:dry      # simular
#   npm run import:knowledge          # importar 1 registo por faixa (6-9, 10-15, 15+)

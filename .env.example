# Copia para .env.local e preenche (nunca commits .env.local).
# Credenciais iguais às do painel /admin-reports.html.

REPORTS_ADMIN_USER=admin
REPORTS_ADMIN_PASS=a_tua_palavra_passe

# URL do site em produção (Cloudflare Pages ou Netlify legado)
REPORTS_BASE_URL=https://reinomagicodosaber.pages.dev

# Multijogador + telemetria IA — painel admin (Netlify Functions)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  (Project Settings → API → service_role — NUNCA no browser)
# Executar também supabase/gen-telemetry.sql no SQL Editor do Supabase.
#
# Importação diária do Knowledge Repository (scripts/daily-knowledge-import.js):
#   npm run import:knowledge:dry   # simular
#   npm run import:knowledge       # importar 1 registo por faixa (6-9, 10-15, 15+)
# GitHub Actions: secrets SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (workflow daily-knowledge-import.yml)
